# Managed Better Auth (every new Neon project — the class path)
DATABASE_URL=            # Neon -> your project -> Connect: the postgresql:// string
NEON_AUTH_BASE_URL=      # Neon -> Auth -> Configuration: the one auth URL (.../neondb/auth)
PUBLIC_URL=              # YOUR server's address (deployed: https://<service>.onrender.com; local: http://127.0.0.1:8000)

# LEGACY Stack-based projects only (provisioned before Neon's move — COURSE-STEPS appendix)
# NEON_AUTH_JWKS_URL=    # old Auth page; the Stack project id is derived from this URL
# STACK_PUB_CLIENT_KEY=  # old Auth page; lets the login form check passwords against Stack
